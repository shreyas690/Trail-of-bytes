{
  "name": "trial-of-bytes-server",
  "version": "1.0.0",
  "description": "Backend server for Trial of Bytes real-time treasure hunt game.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "seed:admin": "node seeds/adminSeed.js",
    "seed:questions": "node seeds/seedQuestions.js",
    "seed:level2": "node seeds/seedDebugQuestions.js",
    "seed": "npm run seed:admin && npm run seed:questions"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "joi": "^17.12.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "redis": "^4.6.13",
    "socket.io": "^4.7.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^2.0.16",
    "cross-env": "^7.0.3",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  }
}
